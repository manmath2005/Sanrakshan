# Smart Helmet Tracker — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ─── Firebase Admin (for Vercel serverless functions) ───────────────────────
# Paste the ENTIRE content of your firebase-service-account.json as a single line
# Get it: Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Your Firebase Realtime Database URL
# Get it: Firebase Console → Realtime Database → Dashboard URL
FIREBASE_DATABASE_URL=https://YOUR_PROJECT_ID-default-rtdb.asia-southeast1.firebasedatabase.app
