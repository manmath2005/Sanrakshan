# downloads/*.apk  ← keep APK in repo for direct download link

# Python cache (local development)
__pycache__/
*.pyc
server.py
verify_sync.py

# ngrok binary (not needed in cloud)
ngrok.exe
*.ngrok.*

# Other local-only files
xampp/
php-portable/
prisma/
