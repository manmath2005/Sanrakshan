# Dependencies
node_modules/

# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local
firebase-service-account.json

# Vercel build output
.vercel/
.output/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

